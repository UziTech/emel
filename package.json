{
  "name": "emel",
  "version": "3.1.2",
  "description": "Create DOM elements with Emmet",
  "main": "./dist/emel.cjs",
  "module": "./src/emel.js",
  "browser": "./dist/emel.umd.js",
  "type": "module",
  "types": "./src/emel.d.ts",
  "files": [
    "dist/",
    "src/"
  ],
  "exports": {
    ".": {
      "import": "./src/emel.js",
      "require": "./dist/emel.cjs"
    }
  },
  "scripts": {
    "test": "npm run build && node --import ./spec/setup.js --test \"spec/**/*.test.*js\"",
    "test:cover": "npm run build && node --import ./spec/setup.js --test --experimental-test-coverage \"spec/**/*.test.*js\"",
    "test:types": "tsd -t src/emel.d.ts -f spec/emel.test-d.ts",
    "lint": "eslint",
    "format": "eslint --fix",
    "build": "rollup -c rollup.config.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UziTech/emel.git"
  },
  "keywords": [
    "emmet",
    "createelement",
    "dom"
  ],
  "author": "Tony Brix <Tony@Brix.ninja> (https://Tony.Brix.ninja)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/UziTech/emel/issues"
  },
  "homepage": "https://github.com/UziTech/emel#readme",
  "dependencies": {
    "@emmetio/abbreviation": "^2.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "rollup": "^4.62.5",
    "semantic-release": "^25.0.9",
    "tsd": "^0.33.0"
  },
  "release": {
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      "@semantic-release/npm",
      "@semantic-release/github",
      "@semantic-release/git"
    ]
  }
}
